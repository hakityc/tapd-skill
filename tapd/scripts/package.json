{
  "name": "workbridge",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "workbridge": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run check:ui && npm run build:ui",
    "build:ui": "vite build --config ui-app/vite.config.ts",
    "check:ui": "tsc -p ui-app/tsconfig.json --noEmit",
    "dev:ui": "vite --config ui-app/vite.config.ts",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "7.10.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "lucide-react": "1.46.0",
    "motion": "13.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.15.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
